{
  "name": "mise",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-mise \"vitest run -c vitest.rules.config.mts\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-mise",
    "seed:emulator": "tsx scripts/seed.ts --emulator",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
